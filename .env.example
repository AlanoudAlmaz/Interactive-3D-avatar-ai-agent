# --- Azure Speech (voice, lip-sync visemes, speech recognition) ---
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=uaenorth
# Optional voice overrides
ZAYED_VOICE_EN=en-US-AndrewMultilingualNeural
ZAYED_VOICE_AR=ar-AE-HamdanNeural

# --- Language model (choose ONE; Azure OpenAI takes precedence) ---
AZURE_OPENAI_ENDPOINT=your_azure_openai_endpoint_here
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here
AZURE_OPENAI_API_VERSION=2024-10-21

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Knowledge, uploads, avatar ---
# ZAYED_KNOWLEDGE_DIR=./knowledge
# ZAYED_UPLOAD_DIR=./uploads
ZAYED_MAX_UPLOAD_MB=25
# Talking portrait (.json from tools/build_portrait.py) or a TalkingHead-compatible 3D avatar (.glb)
ZAYED_AVATAR_URL=/static/avatar/zayed.json
ZAYED_AVATAR_BODY=M
